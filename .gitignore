# =========================================================================
# Intelligent Customer Service — Git ignore
#
# 原则：代码进仓库，**配置和数据留在本地**。
#
# ⚠ 最重要的一条：backend/data/app.db 里存着你在管理后台填的 API Key
#   （只做了 base64 混淆，等同明文）。一旦提交到 GitHub 就是密钥泄露。
#   下面的 data/ 规则确保它不会被误提交。
#
# 验证方式：git status --ignored 看看该忽略的是否都在 Ignored 里；
#          或 git check-ignore -v <文件> 查某个文件被哪条规则挡住。
# =========================================================================

# ─── 密钥与本地配置 ────────────────────────────────────
# .env 存 API Key、数据库连接串；.env.example 是模板，要提交
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example

# 其他可能含密钥的配置
config.json
!config.example.json
secrets.json
*.key
*.pem
*.p12
*.pfx

# ─── 运行时数据（含 API Key 与业务数据）───────────────
# app.db：客服配置（含 API Key）+ 会话记录 + 文档元数据
# chroma_db：向量数据（本项目实测 163MB）
backend/data/
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 各向量库的本地存储
chroma_db/
chroma/
milvus.db
milvus.db.lock
qdrant_storage/

# 用户上传的知识文档
backend/uploads/
uploads/

# ─── 知识库文档（业务数据，可用脚本重新生成）─────────
# 生成脚本会提交（docs/qqmu-knowledge-base/scripts/），
# 产出的 md 不提交 —— 4.6MB 且每次重新生成都是巨大 diff。
docs/qqmu-knowledge-base/*.md
!docs/qqmu-knowledge-base/README.md

# 抓取过程的中间产物
qqmu_raw.json
qqmu_full.json
_meta.json

# ─── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# 测试与缓存
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ─── Node（前端自检用的 jsdom）─────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── 日志与临时文件 ────────────────────────────────────
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*.rej
nohup.out

# ─── IDE / 编辑器 ──────────────────────────────────────
# PyCharm：整个 .idea 都不提交。它记录的是「我这台机器」的解释器路径、
# 窗口布局等，别人 clone 后 PyCharm 会自动重建；提交只会带来无意义冲突。
# 若团队想共享运行配置，改为只忽略 workspace.xml 等个人状态文件。
.idea/

.vscode/*
!.vscode/extensions.json
*.iml
*.iws
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# ─── 操作系统 ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.AppleDouble
.LSOverride

# ─── Docker ────────────────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml

# ─── 其他 ──────────────────────────────────────────────
.ipynb_checkpoints/
*.db.bak
*.sql.gz
*.zip
*.tar.gz
